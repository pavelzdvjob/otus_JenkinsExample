 
Функция СозданиеТовара(Наименование) Экспорт

	Товар = ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
			.ФикцияОбязательныхПолей()
			.Установить("Вид", Перечисления.ВидыТоваров.Товар)
			.Установить("Наименование", Наименование)  
			.Записать()
			;    
			
	Возврат Товар;
	
КонецФункции
 